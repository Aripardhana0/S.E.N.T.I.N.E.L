# ====== APP MODE ======
APP_ENV=demo
DRY_RUN=true
PAPER_TRADE=true
EXECUTION_ENABLED=false
REQUIRE_MANUAL_APPROVAL=true

# ====== OKX ======
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO_TRADING=true

# ====== OPENROUTER (AI Reviewer) ======
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ====== TELEGRAM ======
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ====== MARKET / STRATEGY ======
SYMBOL=BTC-USDT
